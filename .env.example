# Personal access token -> https://supabase.com/dashboard/account/tokens
# Pings EVERY project this account can see. Recommended.
SUPABASE_ACCESS_TOKEN=

# Optional, for projects you don't own / no token: url,key[,table] separated by ';'
# SUPABASE_TARGETS=https://abcdefghijklmnopqrst.supabase.co,eyJ...,some_table
